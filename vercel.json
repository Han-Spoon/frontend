{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.han-spoon.site/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
